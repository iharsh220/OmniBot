# ── Server ────────────────────────────────────────────
PORT=3002
# Public URL of this app (used for OAuth redirect URIs). Change when you deploy, e.g. https://omnichat.example.com
APP_URL=http://localhost:3002
# Public https URL Kick can reach for chat webhooks (defaults to APP_URL). For local testing use a tunnel:
#   cloudflared tunnel --url http://localhost:3002   → PUBLIC_URL=https://xxxx.trycloudflare.com
PUBLIC_URL=
# Encrypts OAuth tokens stored in SQLite. Auto-generated into data/secret.key if empty. Never change it after users log in.
APP_SECRET=

# ── YouTube login (Google Cloud → APIs & Services → Credentials → OAuth client "Web application") ──
# Authorized redirect URI:  {APP_URL}/auth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Kick login (kick.com/settings/developer → Create app) ──
# Redirect URL:  {APP_URL}/auth/kick/callback      Scopes: user:read, channel:read
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# ── Optional tuning ───────────────────────────────────
# YT_CHAT_MIN_POLL_MS=8000      # min delay between YouTube chat polls (quota!)
# YT_OFFLINE_CHECK_MS=60000     # how often to check if a channel went live
# KICK_STATS_POLL_MS=30000
# IDLE_STOP_MS=180000           # pause a user's watchers after their last widget/dashboard closes
# DATA_DIR=data                 # where omnichat.db lives
